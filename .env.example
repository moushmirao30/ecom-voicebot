# Copy to .env and fill in real values. NEVER commit the filled-in .env.

# LiveKit Cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# STT (Deepgram Nova-3)
DEEPGRAM_API_KEY=

# TTS (Cartesia Sonic)
CARTESIA_API_KEY=
# TTS provider (optional): 'cartesia' (default — Sonic with Deepgram Aura
# failover) or 'deepgram' (Aura only, no Cartesia). Use 'deepgram' when Cartesia
# has no credits to avoid a per-utterance 402 failover that glitches the audio.
TTS_PROVIDER=cartesia

# LLM provider — pick ONE:
# (a) Google AI Studio / Gemini. Set GEMINI_API_KEY only — agent.py aliases it
#     to GOOGLE_API_KEY at startup. Free tier = 20 req/day for gemini-2.5-flash.
GEMINI_API_KEY=
# (b) NVIDIA (build.nvidia.com, OpenAI-compatible). If NVIDIA_API_KEY is set,
#     agent.py uses NVIDIA instead of Gemini. Model must support tool calling.
NVIDIA_API_KEY=
# 8b is fast enough for realtime voice (~400-500ms TTFT) and supports tool calls.
# Avoid the 70b variant on the free endpoint — measured 3.5-31s TTFT (unusable).
NVIDIA_LLM_MODEL=meta/llama-3.1-8b-instruct

